{
  "name": "deploy-status-bar",
  "displayName": "Deploy Status Bar",
  "description": "Run npm deploy from the VS Code status bar.",
  "version": "1.0.0",
  "publisher": "local",
  "repository": {
    "type": "git",
    "url": "https://github.com/RedDragonWebDesign/VSCodeExtensions.git",
    "directory": "DeployStatusBar"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onCommand:deployStatusBar.deploy"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Running a workspace's deploy script requires workspace trust."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Running npm requires a local workspace folder."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "deployStatusBar.deploy",
        "title": "Deploy: Run npm deploy"
      }
    ]
  },
  "scripts": {
    "test": "node --test test/*.test.js"
  }
}
