{
  "name": "git-global-username",
  "displayName": "Git Global Username",
  "description": "Displays the global Git user.name and runs name-change shortcuts from the status bar.",
  "version": "1.0.0",
  "publisher": "local",
  "repository": {
    "type": "git",
    "url": "https://github.com/RedDragonWebDesign/VSCodeExtensions.git",
    "directory": "GitGlobalUsername"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onCommand:gitGlobalUser.refresh",
    "onCommand:gitGlobalUser.chooseShortcut"
  ],
  "contributes": {
    "commands": [
      {
        "command": "gitGlobalUser.refresh",
        "title": "Git Global Username: Refresh"
      },
      {
        "command": "gitGlobalUser.chooseShortcut",
        "title": "Git Global Username: Run Name-Change Shortcut"
      }
    ]
  },
  "scripts": {
    "test": "node --test test/*.test.js"
  }
}
